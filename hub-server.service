[Unit]
Description=TDXMediaServe Hub (web page and relay for TouchDesigner and Raspberry Pi nodes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=catatumbo
WorkingDirectory=/home/catatumbo/led_test
Environment="PYTHONUNBUFFERED=1"
# One port for the page, browsers and nodes; 8081 is what TouchDesigner components use by default
ExecStart=/usr/bin/python3 hub_server.py --port 8081
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
